[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/matebot-host-alert backup-failure "Nightly backup failed. Inspect matebot-backup.service on the server."
StateDirectory=matebot/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/matebot/alerts
PrivateTmp=true
