{
  "expo": {
    "name": "Matebot",
    "slug": "matebot",
    "owner": "lizer-expo",
    "scheme": "matebot",
    "version": "1.0.19",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFC",
          "dark": {
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Matebot uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Matebot turns your speech into messages during voice calls.",
          "microphonePermission": "Matebot uses the microphone for voice calls with your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Matebot uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Matebot uses the camera so you can attach photos to a bot message.",
          "microphonePermission": "Matebot uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-lan-cleartext",
      "./plugins/with-agent-notifications",
      "./plugins/with-android-r8",
      "./plugins/with-app-intents"
    ],
    "locales": {
      "es": "./locales/es.json"
    },
    "ios": {
      "bundleIdentifier": "com.matebot.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "../../packages/ui-tokens/assets/Matebot.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Matebot uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Matebot uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Matebot connects to a self-hosted Matebot server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["voip", "audio", "remote-notification"],
        "NSUserActivityTypes": ["INSendMessageIntent"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "android": {
      "package": "com.matebot.app",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "projectId": "4d08d2e7-5be4-4446-a430-8781f9203fae",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RakazoWidgets",
                  "bundleIdentifier": "com.matebot.app.widgets"
                },
                {
                  "targetName": "AgentNotifications",
                  "bundleIdentifier": "com.matebot.app.notifications",
                  "entitlements": {
                    "com.apple.developer.usernotifications.communication": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4d08d2e7-5be4-4446-a430-8781f9203fae"
    }
  }
}
