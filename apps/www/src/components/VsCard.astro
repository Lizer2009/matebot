---
type Props = {
  otherName: string;
  matebot: readonly string[];
  other: readonly string[];
};

const { otherName, matebot, other } = Astro.props;
---

<figure class="vs-card">
  <div class="vs-card__grid">
    <div class="vs-card__col">
      <p class="vs-card__name">Matebot</p>
      <ul>
        {matebot.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <p class="vs-card__vs" aria-hidden="true">vs</p>
    <div class="vs-card__col">
      <p class="vs-card__name">{otherName}</p>
      <ul>
        {other.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <figcaption class="sr-only">Matebot compared with {otherName}</figcaption>
</figure>
