---
import type { HomeCopy } from "../i18n/home";
import type { DesktopDownloads } from "../github";
import { availableDesktopPlatforms, downloadHref } from "../github";
import { APP_URL, GITHUB_URL } from "../site";

type Props = {
  class: string;
  copy: HomeCopy["hero"];
  /** Desktop builds to offer. Windows is always offered: it is the launch download. */
  downloads?: DesktopDownloads;
  /** PostHog `data-attr` prefix that tells this placement apart from others. */
  placement: string;
  githubLabel?: string;
};

const { class: className, copy, downloads, placement, githubLabel = copy.viewOnGithub } =
  Astro.props;

// `data-show` lists the platforms (set on <html> by the HomePage script) that see each action.
// Exactly one primary action shows per platform: the Windows installer on computers, the Android
// APK on Android, and the web app everywhere as the secondary action. The Android button does not
// wait for the release lookup: `/api/download?platform=android` resolves per request, so the first
// APK needs no site rebuild, and the redirect falls back to the releases page until one exists.
const desktopPlatforms = downloads ? availableDesktopPlatforms(downloads) : [];
const otherDownloads = desktopPlatforms
  .filter((platform) => platform !== "windows")
  .map((platform) => ({ platform, href: downloadHref(platform), label: copy.download[platform] }));
// Linux keeps the GitHub link until a release ships an AppImage.
const githubPlatforms = desktopPlatforms.includes("linux") ? "" : "linux";
---

<div class={className}>
  <a
    class="button button--primary"
    href={downloadHref("windows")}
    data-show="mac windows linux"
    data-attr={`${placement}-windows`}
  >
    {copy.download.windows}
  </a>
  <a
    class="button button--primary"
    href={downloadHref("android")}
    data-show="android"
    data-attr={`${placement}-android`}
  >
    {copy.download.android}
  </a>
  <a
    class="button button--secondary"
    href={APP_URL}
    data-show="ios android mac windows linux web"
    data-attr={`${placement}-web`}
  >
    {copy.getStarted}
  </a>
  {
    otherDownloads.map((download) => (
      <a class="button button--secondary" href={download.href} data-show={download.platform}>
        {download.label}
      </a>
    ))
  }
  {
    githubPlatforms && (
      <a
        class="button button--secondary"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        data-show={githubPlatforms}
        data-attr={`${placement}-github`}
      >
        {githubLabel}
      </a>
    )
  }
</div>
