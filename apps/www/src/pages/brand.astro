---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { BRAND_COLORS, BRAND_LOGOS } from "../brand";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Brand · Matebot" description="Matebot logos and colors for press and partners.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy brand-kit">
      <h1>Brand</h1>
      <p>Logos and colors for writing about Matebot.</p>
      <h2>Logos</h2>
      <ul class="brand-kit__logos">
        {
          BRAND_LOGOS.map((logo) => (
            <li>
              <a class="brand-kit__logo" href={logo.file} download tabindex="-1" aria-hidden="true">
                <img src={logo.preview} alt="" loading="lazy" />
              </a>
              <a href={logo.file} download>{logo.name}</a>
              <span>{logo.format}</span>
            </li>
          ))
        }
      </ul>
      <h2>Colors</h2>
      <ul class="brand-kit__colors">
        {
          BRAND_COLORS.map((color) => (
            <li>
              <span class="brand-kit__swatch" style={`background:${color.hex}`} />
              <strong>{color.name}</strong>
              <code>{color.hex}</code>
            </li>
          ))
        }
      </ul>
      <h2>Usage</h2>
      <p>Write Matebot with a capital M in text. Do not alter the mark or imply an endorsement.</p>
      <p>Logos are free to use under the terms in <a href="https://github.com/Lizer2009/matebot">the repository</a>. This site is a fork of Rakazo; its own brand assets are separate.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
