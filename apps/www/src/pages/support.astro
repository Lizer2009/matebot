---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH, UPSTREAM_URL } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Support · Matebot" description="Get help with Matebot and a self-hosted Matebot deployment.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Matebot support</h1>
      <p>
        Matebot is self-hosted, so the person or team operating the server you sign in to is the right
        place to start: they control accounts, models, computers, and the data in your Space. Include what
        you expected to happen and any error message you saw. Do not send passwords, API keys, access
        tokens, or other secrets.
      </p>
      <h2>Set up your own server</h2>
      <p>
        Start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>. For reproducible bugs in the
        software, open an issue in the <a href={`${GITHUB_URL}/issues`}>Matebot GitHub repository</a>.
        Behavior shared with the upstream project it forked from is also worth checking in
        <a href={UPSTREAM_URL}>Rakazo</a>.
      </p>
      <h2 id="account-deletion">Account deletion</h2>
      <p>
        In the app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. On the web, sign in and do the same under{" "}
        <strong>Settings</strong> → <strong>Account</strong>. This permanently deletes your account and its
        associated personal Space data.
      </p>
      <p>
        If you cannot sign in, ask the server operator to remove the account. Sign-in security records are
        kept for up to 90 days.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
