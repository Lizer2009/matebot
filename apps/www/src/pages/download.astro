---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  availableDesktopPlatforms,
  downloadHref,
  fetchDesktopDownloads,
  githubStarsLabel,
} from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, SELF_HOST_GUIDE_PATH } from "../site";

const [starsLabel, desktopDownloads] = await Promise.all([
  githubStarsLabel(),
  fetchDesktopDownloads(),
]);

const DESKTOP_NAMES = { mac: "macOS", windows: "Windows", linux: "Linux" } as const;
const platforms = [
  ...availableDesktopPlatforms(desktopDownloads).map((platform) => ({
    name: DESKTOP_NAMES[platform],
    action: "Download",
    href: downloadHref(platform),
    attr: platform,
  })),
  // Android gets a build before iOS does; `/api/download` resolves the APK per request, so this
  // page needs no rebuild when one is published.
  { name: "Android", action: "Download the APK", href: downloadHref("android"), attr: "android" },
  { name: "iPhone", action: "Open the web app", href: APP_URL, attr: "web" },
];
---

<BaseLayout title="Download · Matebot" description="Get Matebot for macOS, Windows, Linux, Android, or in your browser.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Download Matebot</h1>
      <ul class="platform-list">
        {
          platforms.map((platform) => (
            <li>
              <span>{platform.name}</span>
              <a
                class="button button--secondary button--small"
                href={platform.href}
                aria-label={`${platform.action}: ${platform.name}`}
                data-attr={`download-page-${platform.attr}`}
              >
                {platform.action}
              </a>
            </li>
          ))
        }
      </ul>
      <p>
        Running your own server? The apps connect to it too. See the{" "}
        <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
